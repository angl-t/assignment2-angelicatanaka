<%- include("./templates/header") %>
<% if (!loggeduser) { %>
    <div class="container">
        <div class="d-grid gap-2">
            <a class="btn btn-primary mt-3" href="/signup" role="button">Sign up</a>
            <a class="btn btn-primary mt-3" href="/login" role="button">Log in</a>
        </div>
    </div>
<% } %>
<% if (loggeduser) { %>    
    <div class="container">
        <h1>Welcome, <%= name %>!</h1>
        <div class="d-grid gap-2">
            <a class="btn btn-primary mt-3" href="/members" role="button">Members Area</a>
            <a class="btn btn-primary mt-3" href="/logout" role="button">Log out</a>
        </div>
    </div>
<% } %>
<%- include("./templates/footer") %>