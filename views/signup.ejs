<%- include("./templates/header") %>
<div class="container mt-3 md-3">
<div class="alert alert-danger" role="alert">
    <%= errorMessage %>
    <hr>
    <a href="/signup" class="alert-link">Try again</a>
</div>
<form action='/signingup' method='post'>
    <h2>Create User</h2>
    <div class="form-floating mb-3">
        <input name="name" type="text" class="form-control" id="floatingInput" placeholder="name">
        <label for="floatingInput">Name</label>
    </div>
    <div class="form-floating mb-3">
        <input name="email" type="text"  class="form-control" id="floatingInput" placeholder="name@example.com">
        <label for="floatingInput">Email address</label>
    </div>
    <div class="form-floating">
        <input name="password" type="text"  class="form-control" id="floatingPassword" placeholder="Password">
        <label for="floatingPassword">Password</label>
    </div>
    <div class="form-floating">
        <button class="btn btn-primary btn-lg mt-3 md-3">Submit</button>
    </div>
</form>
</div>
<%- include("./templates/footer") %>